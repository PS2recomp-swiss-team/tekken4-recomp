 #include <xmmintrin.h>
 
+extern std::atomic<uint64_t> g_ps2xGsRingWaitNs; // gpu/gs_hw_backend.cpp
+
 namespace
 {
     constexpr size_t kPublishBytes = 64u * 1024u;
@@ -226,7 +229,21 @@ void GSThreadedBackend::WorkerLoop()
         {
             std::lock_guard<std::mutex> exec(m_execMutex);
             ps2_perf_stats::Timer busy(ps2_perf_stats::g_counters.gsWorkerBusyNs);
+            static const bool slowLog = []
+            {
+                const char *v = std::getenv("PS2X_GS_SLOW_LOG");
+                return v && *v == '1';
+            }();
+            const auto t0 = std::chrono::steady_clock::now();
+            const uint64_t ring0 = g_ps2xGsRingWaitNs.load(std::memory_order_relaxed);
             Execute(chunk, draw);
+            if (slowLog)
+            {
+                const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+                if (ms > 10.0)
+                    std::fprintf(stderr, "[gs-slow] chunk %zu bytes %.1f ms, vertex ring fence wait %.1f ms\n", chunk.size(), ms,
+                                 static_cast<double>(g_ps2xGsRingWaitNs.load(std::memory_order_relaxed) - ring0) / 1e6);
+            }
         }
         {
             std::lock_guard<std::mutex> lock(m_queueMutex);
