+    uint32_t pageRowsFor(uint32_t psm)
+    {
+        switch (psm & 0x3F)
+        {
+        case 0x13: case 0x1B: case 0x24: case 0x2C: return 64u;  // T8 / T8H
+        case 0x14: case 0x2C + 1: return 128u;                    // T4
+        case 0x02: case 0x0A: case 0x32: case 0x3A: return 64u;  // 16 bit
