+        g.BindVertexArray(vao);
+        g.GenBuffers(1, &vbo);
+        g.BindBuffer(kArrayBuffer, vbo);
+        const GLsizei stride = sizeof(HwVertex);
+        g.VertexAttribPointer(0, 2, kFloat, kFalse, stride, reinterpret_cast<const void *>(offsetof(HwVertex, x)));
