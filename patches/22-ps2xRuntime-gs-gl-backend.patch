+    constexpr int kContextMajorVersion = 0x2091;
+    constexpr int kContextMinorVersion = 0x2092;
+    constexpr int kContextFlags = 0x2094;
+    constexpr int kContextProfileMask = 0x9126;
+    constexpr int kContextCoreProfileBit = 0x0001;
