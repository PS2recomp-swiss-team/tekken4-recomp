+            link(kMovieScaleFs, movieScaleProgram);
+            if (movieScaleProgram)
+                locMsSrc = g.GetUniformLocation(movieScaleProgram, "uSrc"), locMsScale = g.GetUniformLocation(movieScaleProgram, "uScale"),
+                locMsBounds = g.GetUniformLocation(movieScaleProgram, "uBounds");
             if (areaProgram)
                 locAreaSrc = g.GetUniformLocation(areaProgram, "uSrc"), locAreaRatio = g.GetUniformLocation(areaProgram, "uRatio");
             if (fxaaProgram)
@@ -2046,6 +2084,22 @@ struct GSHwBackend::Impl
         return t;
     }
 
+    // Tekken 4 port: true while a movie hands out pictures (one in the last 0.5 s). Only its uploads get the smooth
+    // upscale; the game's own uploads into targets keep the filtered blit.
+    uint32_t movieSeenPictures = 0u;
+    std::chrono::steady_clock::time_point movieSeenAt{};
+    bool movieActive()
+    {
+        const uint32_t n = ps2_stubs::mpegPicturesServed();
+        const auto now = std::chrono::steady_clock::now();
+        if (n != movieSeenPictures)
+        {
+            movieSeenPictures = n;
+            movieSeenAt = now;
+        }
+        return n != 0u && now - movieSeenAt < std::chrono::milliseconds(500);
+    }
+
     void applyRtUpload()
     {
         if (!rtUploadPending)
@@ -2096,14 +2150,45 @@ struct GSHwBackend::Impl
             g.BindTexture(kTexture2D, t->stageTex);
             g.PixelStorei(kUnpackAlignment, 4);
             g.TexSubImage2D(kTexture2D, 0, static_cast<GLint>(x0), static_cast<GLint>(y0), w, h, kRgba, kUnsignedByte, pixels.data());
-            const uint32_t sx0 = x0 ? x0 - 1u : 0u, sy0 = y0 ? y0 - 1u : 0u;
             const auto host = [&](uint32_t v) { return static_cast<GLint>(std::lround(static_cast<double>(v) * scale)); };
-            g.BindFramebuffer(0x8CA8 /*READ_FRAMEBUFFER*/, t->stageFbo);
-            g.BindFramebuffer(0x8CA9 /*DRAW_FRAMEBUFFER*/, t->fbo);
-            g.Disable(kScissorTest);
-            g.BlitFramebuffer(static_cast<GLint>(sx0), static_cast<GLint>(sy0), static_cast<GLint>(x0 + w), static_cast<GLint>(y0 + h),
-                              host(sx0), host(sy0), host(x0 + w), host(y0 + h), kColorBufferBit, scale > 1.0f ? kLinear : kNearest);
-            g.BindFramebuffer(kFramebuffer, t->fbo);
+            if (scale > 1.0f && movieScaleProgram && movieActive())
+            {
+                // Bicubic pass over the strip and 2 texels left / up of it: the bicubic reaches 2 texels to the right and below,
+                // so the previous strip's last columns (drawn with this strip's border repeated) are redrawn with their
+                // true neighbours; the last strip of the picture needs no neighbours to its right.
+                const uint32_t sx0 = x0 >= 2u ? x0 - 2u : 0u, sy0 = y0 >= 2u ? y0 - 2u : 0u;
+                g.BindFramebuffer(kFramebuffer, t->fbo);
+                g.Viewport(0, 0, t->glW, t->glH);
+                g.Enable(kScissorTest);
+                g.Scissor(host(sx0), host(sy0), host(x0 + w) - host(sx0), host(y0 + h) - host(sy0));
+                g.Disable(kBlend);
+                g.Disable(kDepthTest);
+                g.Disable(kCullFace);
+                g.DepthMask(kFalse);
+                g.ColorMask(kTrue, kTrue, kTrue, kTrue);
+                g.UseProgram(movieScaleProgram);
+                g.ActiveTexture(kTexture0);
+                g.BindTexture(kTexture2D, t->stageTex);
+                g.Uniform1i(locMsSrc, 0);
+                g.Uniform2f(locMsScale, scale, scale);
+                g.Uniform4i(locMsBounds, 0, 0, static_cast<GLint>(x0 + w) - 1, static_cast<GLint>(y0 + h) - 1);
+                g.BindVertexArray(presentVao);
+                g.DrawArrays(kTriangles, 0, 3);
+                g.BindVertexArray(vao);
+                g.UseProgram(program);
+                g.BindBuffer(kArrayBuffer, vbo);
+                g.Disable(kScissorTest);
+            }
+            else
+            {
+                const uint32_t sx0 = x0 ? x0 - 1u : 0u, sy0 = y0 ? y0 - 1u : 0u;
+                g.BindFramebuffer(0x8CA8 /*READ_FRAMEBUFFER*/, t->stageFbo);
+                g.BindFramebuffer(0x8CA9 /*DRAW_FRAMEBUFFER*/, t->fbo);
+                g.Disable(kScissorTest);
+                g.BlitFramebuffer(static_cast<GLint>(sx0), static_cast<GLint>(sy0), static_cast<GLint>(x0 + w), static_cast<GLint>(y0 + h),
+                                  host(sx0), host(sy0), host(x0 + w), host(y0 + h), kColorBufferBit, scale > 1.0f ? kLinear : kNearest);
+                g.BindFramebuffer(kFramebuffer, t->fbo);
+            }
         }
         t->usedW = std::max(t->usedW, x0 + w);
         t->usedH = std::max(t->usedH, y0 + h);
diff --git a/ps2xRuntime/src/lib/ps2_audio.cpp b/ps2xRuntime/src/lib/ps2_audio.cpp
index 675109e..0a05fe1 100644
--- a/ps2xRuntime/src/lib/ps2_audio.cpp
+++ b/ps2xRuntime/src/lib/ps2_audio.cpp
@@ -3,6 +3,7 @@
 #include "ps2_host_backend.h"
 #include "ps2x/iop/iop_host.h"
 #include <algorithm>
+#include <atomic>
 #include <cmath>
 #include <cstdint>
 #include <cstdio>
@@ -343,6 +344,16 @@ std::vector<int16_t> g_moviePcm;
 bool g_movieStarted = false;
 uint64_t g_moviePlayedFrames = 0u;
 uint64_t g_movieMissingFrames = 0u;
+// Tekken 4 port: the audio device plays the movie's sound from its own copy of the PCM, pulled by the device callback,
+// not through the mixer tick -> DeviceQueue path (a 43 ms buffer that the game thread refills once per frame): any
+// game-thread stall over ~40 ms (at 1440p / 4K the frame work is heavier and the host is busier) left the device
+// with silence in the middle of the movie's music although seconds of it were queued. g_moviePcm stays the
+// producer-side copy (mixer tick: WAV capture, played / missing accounting); both are filled and cleared together.
+std::mutex g_movieDevMutex;
+std::vector<int16_t> g_movieDevPcm;
+size_t g_movieDevRead = 0u;      // samples already played from the front of g_movieDevPcm
+bool g_movieDevStarted = false;
+std::atomic<uint64_t> g_movieDevMissing{0u}; // device frames asked for after the first push that found the copy empty
 
 namespace
 {
@@ -437,9 +448,9 @@ namespace
             m_statMaxRate = std::max(m_statMaxRate, rate);
             if (m_statPulled < 240000u)
                 return;
-            std::fprintf(stderr, "[audio-device] pulled=%zu missing=%zu dropped=%zu level=%zu-%zu rate=%.3f-%.3f\n",
+            std::fprintf(stderr, "[audio-device] pulled=%zu missing=%zu dropped=%zu level=%zu-%zu rate=%.3f-%.3f movie-missing=%llu\n",
                          m_statPulled, m_missing, m_dropped, m_statMinLevel, m_statMaxLevel, m_statMinRate,
-                         m_statMaxRate);
+                         m_statMaxRate, static_cast<unsigned long long>(g_movieDevMissing.exchange(0u)));
             m_statPulled = m_missing = m_dropped = m_statMaxLevel = 0u;
             m_statMinLevel = SIZE_MAX;
             m_statMinRate = m_statMaxRate = 1.0;
@@ -461,9 +472,35 @@ namespace
         return *queue;
     }
 
+    // Adds the movie's sound straight from the device callback (see g_movieDevPcm).
+    void mixDeviceMovie(int16_t *out, size_t frames)
+    {
+        std::lock_guard<std::mutex> lock(g_movieDevMutex);
+        if (!g_movieDevStarted)
+            return;
+        const size_t have = (g_movieDevPcm.size() - g_movieDevRead) / 2u;
+        const size_t n = frames < have ? frames : have;
+        const int16_t *in = g_movieDevPcm.data() + g_movieDevRead;
+        for (size_t i = 0; i < n * 2u; ++i)
+        {
+            const int32_t sum = static_cast<int32_t>(out[i]) + static_cast<int32_t>(in[i]);
+            out[i] = static_cast<int16_t>(sum > 32767 ? 32767 : sum < -32768 ? -32768 : sum);
+        }
+        g_movieDevRead += n * 2u;
+        if (frames > n)
+            g_movieDevMissing += frames - n;
+        if (g_movieDevRead >= 48000u * 2u)
+        {
+            g_movieDevPcm.erase(g_movieDevPcm.begin(), g_movieDevPcm.begin() + static_cast<std::ptrdiff_t>(g_movieDevRead));
+            g_movieDevRead = 0u;
+        }
+    }
+
     void onDeviceRequest(void *buffer, unsigned int frames)
     {
-        deviceQueue().pull(static_cast<int16_t *>(buffer), frames);
+        int16_t *out = static_cast<int16_t *>(buffer);
+        deviceQueue().pull(out, frames);
+        mixDeviceMovie(out, frames);
     }
 #endif
 
