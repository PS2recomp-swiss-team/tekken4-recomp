+GS::WsTarget &GS::wsTarget(uint32_t fbp)
+{
+    WsTarget *oldest = &m_wsTargets[0];
+    for (WsTarget &t : m_wsTargets)
+    {
+        if (t.genDrawn != 0u && t.fbp == fbp)
+            return t;
+        if (t.genDrawn < oldest->genDrawn)
+            oldest = &t;
+    }
+    *oldest = WsTarget{fbp, 0u, 0u};
+    return *oldest;
+}
+
+// Widescreen 16:9 (TEKKEN4_WIDESCREEN; docs/WIDESCREEN.md in the Tekken 4 project). Host-only: the guest runs its own
+// 4:3 code, nothing here reaches guest memory, the IOP or the EE's timing (the GS is output), so a 16:9 player and a
+// 4:3 player simulate the same game. The VU1 (PATH1) 3D is drawn 3/4 as wide around the screen centre: the 4:3 view
+// fills the middle of the 640-wide target and what the game's VU1 programs send beyond the 4:3 edges (they cull
+// against the GS's guard band, not the screen) fills the sides. The window then shows such a picture at 16:9. The EE's
+// own draws into a 640-wide target holding 3D of this or the last picture (HUD, names, timer, and the hit sparks the EE
+// projects as sprites: PATH2/PATH3) are squeezed the same way, so the HUD keeps its 4:3 shape in the middle and the
+// sparks stay on the fighters. Not squeezed: draws that read a render target (the back->display copy, post effects;
+// they carry the "3D" mark on to their target) and draws spanning the whole width or height (fills, fades, flashes;
+// the game draws its screen fill as 64-pixel columns: squeezed, it left the sides uncleared).
+void GS::widescreenAdjust(GSPrimitiveBatch &batch)
+{
+    const GSContext &c = batch.state.context;
+    WsTarget &target = wsTarget(c.frame.fbp);
+    target.genDrawn = m_wsGen;
+    const float ofx = static_cast<float>(c.xyoffset.ofx) / 16.0f;
+    const float ofy = static_cast<float>(c.xyoffset.ofy) / 16.0f;
+    const float centre = ofx + 320.0f;
+    const auto squeeze = [&]
+    {
+        for (int i = 0; i < batch.vertexCount; ++i)
+        {
+            float &x = batch.vertices[static_cast<size_t>(i)].x;
+            x = centre + (x - centre) * 0.75f;
+        }
+    };
+    if (gifCurrentPath() == static_cast<uint8_t>(GifPathId::Path1))
+    {
+        target.gen3d = m_wsGen;
+        target.fbw = c.frame.fbw;
+        ++target.draws3d;
+        ++m_wsStat[0];
+        if (c.frame.fbw == 10u)
+            squeeze();
+        return;
+    }
+    // A render target read as a texture: a frame-buffer format at least 512 texels wide whose base lies in a recent
+    // target (palette textures, PSMT4/PSMT8, and small textures are game art even when VRAM places them there).
+    const uint8_t psm = c.tex0.psm;
+    const bool fbFormat = psm == 0x00u || psm == 0x01u || psm == 0x02u || psm == 0x0Au;
+    if (batch.state.prim.tme && fbFormat && c.tex0.tw >= 9u)
+    {
+        constexpr uint32_t kFrameBlocks = 640u * 512u * 4u / 256u; // a 640x512 32-bit frame in 256-byte blocks
+        const uint32_t tbp = c.tex0.tbp0;
+        for (const WsTarget &u : m_wsTargets)
+        {
+            if (u.genDrawn == 0u || u.genDrawn + 2u < m_wsGen)
+                continue;
+            const uint32_t base = u.fbp * 32u;
+            if (tbp >= base && tbp < base + kFrameBlocks)
+            {
+                if (&u != &target && wsWide(u))
+                    target.gen3d = std::max(target.gen3d, u.gen3d);
+                ++m_wsStat[5];
+                return;
+            }
+        }
+    }
+    if (c.frame.fbw != 10u || !wsWide(target))
+    {
+        ++m_wsStat[c.frame.fbw != 10u ? 2 : 3];
+        return;
+    }
+    float minX = 1e9f, maxX = -1e9f, minY = 1e9f, maxY = -1e9f;
+    for (int i = 0; i < batch.vertexCount; ++i)
+    {
+        const GSVertex &v = batch.vertices[static_cast<size_t>(i)];
+        minX = std::min(minX, v.x - ofx);
+        maxX = std::max(maxX, v.x - ofx);
+        minY = std::min(minY, v.y - ofy);
+        maxY = std::max(maxY, v.y - ofy);
+    }
+    if ((minX <= 0.5f && maxX >= 639.5f) || maxY - minY >= 400.0f)
+    {
+        ++m_wsStat[4];
+        return;
+    }
+    ++m_wsStat[1];
+    squeeze();
+}
+
