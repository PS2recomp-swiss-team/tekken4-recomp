index 5be4562..a119897 100644
--- a/ps2xRuntime/src/lib/ps2_memory.cpp
+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -11,6 +11,62 @@
 #include <algorithm>
 #include <string>
 #include <vector>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+namespace
+{
+    // Tekken 4 port (netplay): RDRAM with a Windows write watch, so a rollback snapshot copies only the pages written
+    // since that ring slot was last filled (ps2_rollback.cpp). PS2X_RDRAM_WRITE_WATCH=0: plain heap memory as before.
+    bool g_rdramWriteWatch = false;
+
+    uint8_t *allocRdram(size_t size)
+    {
+#ifdef _WIN32
+        const char *setting = std::getenv("PS2X_RDRAM_WRITE_WATCH");
+        if (!setting || *setting != '0')
+        {
+            void *p = VirtualAlloc(nullptr, size, MEM_RESERVE | MEM_COMMIT | MEM_WRITE_WATCH, PAGE_READWRITE);
+            if (p)
+            {
+                g_rdramWriteWatch = true;
+                return static_cast<uint8_t *>(p); // committed pages are zero
+            }
+        }
+#endif
+        g_rdramWriteWatch = false;
+        uint8_t *p = new uint8_t[size];
+        std::memset(p, 0, size);
+        return p;
+    }
+
+    void freeRdram(uint8_t *p)
+    {
+        if (!p)
+            return;
+#ifdef _WIN32
+        if (g_rdramWriteWatch)
+        {
+            VirtualFree(p, 0, MEM_RELEASE);
+            g_rdramWriteWatch = false;
+            return;
+        }
+#endif
+        delete[] p;
+    }
+}
+
+bool PS2Memory::rdramWriteWatch() const
+{
+    return g_rdramWriteWatch && m_rdram != nullptr;
+}
 
