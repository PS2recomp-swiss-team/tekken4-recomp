+    static void callLower(VU1NativeCtx &n, uint32_t pc, uint32_t lower, uint32_t upper);
+    static void callUpper(VU1NativeCtx &n, uint32_t pc, uint32_t upper);
+    static void xgkick(VU1NativeCtx &n, uint32_t qwordAddress);
