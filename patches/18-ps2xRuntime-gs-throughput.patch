-
-    if (state.prim.tme)
-    {
-        const auto &tex = ctx.tex0;
-        const int texW = state.textureWidth;
-        const int texH = state.textureHeight;
-
-        float u0f, v0f, u1f, v1f;
-        if (state.prim.fst)
