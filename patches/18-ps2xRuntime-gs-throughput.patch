-            uint8_t r, g, b, a;
-            if (state.prim.iip)
-            {
-                r = clampU8(static_cast<int>(v0.r * w0 + v1.r * w1 + v2.r * w2));
-                g = clampU8(static_cast<int>(v0.g * w0 + v1.g * w1 + v2.g * w2));
-                b = clampU8(static_cast<int>(v0.b * w0 + v1.b * w1 + v2.b * w2));
-                a = clampU8(static_cast<int>(v0.a * w0 + v1.a * w1 + v2.a * w2));
-            }
-            else
-            {
-                r = v2.r;
-                g = v2.g;
-                b = v2.b;
-                a = v2.a;
