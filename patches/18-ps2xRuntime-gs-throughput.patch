-            // The GS supplies 0x80 as destination alpha for RGB24 blending.
-            fbrgba |= 0x80000000u;
-        }
-    }
-
-    if (!passesDestinationAlphaTest(p.test, static_cast<uint8_t>(p.fpsm), rawFramebufferPixel))
-    {
-        return;
-    }
-
-    bool zpass = false;
-    uint32_t storedZ = 0u;
-    switch (p.ztestMethod)
-    {
-    case 0:
-        zpass = false;
-        break;
-    case 1:
-        zpass = true;
