+    void coverRepeat(int i0, int i1, int size, AxisCover &axis)
+    {
+        if (size <= 1)
+        {
+            axis.a0 = 0;
+            axis.a1 = 0;
+            return;
+        }
+        if (i1 < i0)
+            std::swap(i1, i0);
+        if (i1 - i0 >= size)
+        {
+            axis.full = true;
+            return;
+        }
+        const int start = static_cast<int>(static_cast<uint32_t>(i0) & static_cast<uint32_t>(size - 1));
+        const int span = i1 - i0;
+        if (start + span < size)
+        {
+            axis.a0 = start;
+            axis.a1 = start + span;
+            return;
+        }
+        axis.a0 = start;
+        axis.a1 = size - 1;
+        axis.b0 = 0;
+        axis.b1 = start + span - size;
+    }
