+    // One axis of the texels a primitive can read, in texture space. Two intervals when REPEAT wraps.
+    struct AxisCover
+    {
+        bool full = false;
+        int a0 = 0;
+        int a1 = -1;
+        int b0 = 0;
+        int b1 = -1;
+    };
