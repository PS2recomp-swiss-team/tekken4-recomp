-void GSCpuBackend::Submit(const GSPrimitiveBatch &batch)
-{
-    std::lock_guard<std::mutex> lock(m_mutex);
-    if (!m_vram || batch.vertexCount == 0u)
-        return;
-    if (!m_workersConfigured)
-        StartWorkersIfConfigured();
-    if (m_workers.empty())
-    {
-        DrawPrimitive(batch);
-        return;
-    }
-
-    // The bands run ahead of each other, so drawing into memory and sampling it must not overlap in the queue.
-    // Drawn pages: the frame (and Z) pages under the primitive's bounding box; sampled pages: its whole texture.
-    const auto &ctx = batch.state.context;
-    const float ofx = static_cast<float>(ctx.xyoffset.ofx >> 4), ofy = static_cast<float>(ctx.xyoffset.ofy >> 4);
-    float minX = batch.vertices[0].x, maxX = minX, minY = batch.vertices[0].y, maxY = minY;
-    for (uint32_t i = 1; i < std::min<uint32_t>(batch.vertexCount, 3u); ++i)
-    {
-        minX = std::min(minX, batch.vertices[i].x);
-        maxX = std::max(maxX, batch.vertices[i].x);
-        minY = std::min(minY, batch.vertices[i].y);
-        maxY = std::max(maxY, batch.vertices[i].y);
-    }
-    const int x0 = std::max(static_cast<int>(std::floor(minX - ofx)) - 1, static_cast<int>(ctx.scissor.x0));
-    const int x1 = std::min(static_cast<int>(std::ceil(maxX - ofx)) + 1, static_cast<int>(ctx.scissor.x1));
-    const int y0 = std::max(static_cast<int>(std::floor(minY - ofy)) - 1, static_cast<int>(ctx.scissor.y0));
-    const int y1 = std::min(static_cast<int>(std::ceil(maxY - ofy)) + 1, static_cast<int>(ctx.scissor.y1));
-    const bool zTouched = !ctx.zbuf.zmask || ((ctx.test >> 17) & 3u) != 1u; // Z written, or tested (not ALWAYS)
-    const PageRect frame = MakePageRect(ctx.frame.fbp * 32u, ctx.frame.fbw, ctx.frame.psm, x0, y0, x1, y1);
-    const PageRect z = zTouched ? MakePageRect(ctx.zbuf.zbp * 32u, ctx.frame.fbw, ctx.zbuf.psm, x0, y0, x1, y1) : PageRect{};
-    const PageRect texture = batch.state.prim.tme
-                                 ? MakePageRect(ctx.tex0.tbp0, ctx.tex0.tbw, ctx.tex0.psm, 0, 0,
-                                                static_cast<int>(batch.state.textureWidth) - 1,
-                                                static_cast<int>(batch.state.textureHeight) - 1)
-                                 : PageRect{};
-    if (AnyPages(m_queuedWritePages, texture))
-        WaitForWorkersUnlocked(DrainReason::SampleConflict);
-    else if (AnyPages(m_queuedReadPages, frame) || AnyPages(m_queuedReadPages, z))
-        WaitForWorkersUnlocked(DrainReason::WriteConflict);
-    MarkPages(m_queuedWritePages, frame);
-    MarkPages(m_queuedWritePages, z);
-    MarkPages(m_queuedReadPages, texture);
-    ++m_statPrimitives;
-
-    uint64_t published = m_published.load(std::memory_order_relaxed); // this thread is the only writer
-    if ((published & 0xFFFFFFFFu) == kJobChunkSize * kMaxJobChunks)
-    {
-        WaitForWorkersUnlocked(DrainReason::QueueFull);
-        published = m_published.load(std::memory_order_relaxed);
-    }
-    const uint32_t slot = static_cast<uint32_t>(published & 0xFFFFFFFFu);
-    std::unique_ptr<Job[]> &chunk = m_jobChunks[slot / kJobChunkSize];
-    if (!chunk)
-        chunk = std::make_unique<Job[]>(kJobChunkSize);
-    Job &job = chunk[slot % kJobChunkSize];
-    job.batch = batch;
-    job.clut = m_clut;
-    job.epoch = m_epoch;
-    m_published.store(published + 1u); // seq_cst: pairs with the sleeper count (see WorkerLoop)
-    // Waking threads costs more than a primitive: let a few queue up first (a wait for the workers wakes them too).
-    if (slot + 1u - m_lastWakeCount >= 16u)
-        WakeWorkers();
-}
-
-void GSCpuBackend::WakeWorkers() const
-{
-    m_lastWakeCount = static_cast<uint32_t>(m_published.load(std::memory_order_relaxed) & 0xFFFFFFFFu);
-    if (m_sleepers.load() == 0u)
-        return;
-    std::lock_guard<std::mutex> jobLock(m_jobMutex);
-    m_jobCv.notify_all();
-}
