From d5b233edf27897a7b179ea0c6818aa1187e1bbaa Mon Sep 17 00:00:00 2001
From: Tommy <tommy@pham.cc>
Date: Thu, 29 Oct 2026 02:36:43 +0100
Subject: [PATCH] Rollback: VU1 cut, idle-loop skipping, host profile counters

- CutVu1: MSCAL microprograms are not run in a re-simulated frame (their output is the GS and VU1 data
  memory; HostProfile::hashVu1Data=false leaves VU1 data out of the state hash).
- EeScheduler::setIdleLoopPcs: a backward-edge checkpoint at a registered idle-loop pc accounts the loop's
  iterations up to just before the next deadline / EE timer interrupt / slice end in one step (empty by
  default; the Tekken 4 driver registers the vsync wait at 0x22a150, ~70% of a fight frame's EE cycles).
- HostProfile: host time in VU1 runs and VIF1 processing (only when a driver turns it on).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ps2xRuntime/include/runtime/ee_scheduler.h    |  8 +++++
 .../include/runtime/ps2_rollback_cuts.h       | 34 +++++++++++++++++++
 ps2xRuntime/src/lib/Kernel/EeScheduler.cpp    | 31 +++++++++++++++++
 ps2xRuntime/src/lib/ps2_rollback.cpp          |  4 ++-
 ps2xRuntime/src/lib/ps2_runtime.cpp           |  4 +++
 ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp  |  2 ++
 6 files changed, 82 insertions(+), 1 deletion(-)

diff --git a/ps2xRuntime/include/runtime/ee_scheduler.h b/ps2xRuntime/include/runtime/ee_scheduler.h
index 68a6b02..3bfbe45 100644
--- a/ps2xRuntime/include/runtime/ee_scheduler.h
+++ b/ps2xRuntime/include/runtime/ee_scheduler.h
@@ -380,6 +380,11 @@ public:
     // the order of cycle-due events depend on EE cycles only (never on host pacing), see processDueDeadlines.
     using BoundaryHook = std::function<void(const EeBoundaryInfo &)>;
     void setBoundaryHook(BoundaryHook hook);
+    // Idle loops (rollback modes): a backward-edge checkpoint at one of these guest pcs, where the loop only burns
+    // cycles until an event, accounts all iterations up to just before the next event (deadline, EE timer
+    // interrupt, slice end) in one step. The EE sees the same cycles and events; empty = off (default).
+    void setIdleLoopPcs(std::vector<uint32_t> pcs) { m_idleLoopPcs = std::move(pcs); }
+    [[nodiscard]] uint64_t idleSkippedCycles() const noexcept { return m_idleSkippedCycles; }
     [[nodiscard]] uint64_t eeCycle() const noexcept { return m_eeCycle; }
     // Host time the executor spent waiting for pacing deadlines (rollback mode only; 0 otherwise).
     [[nodiscard]] uint64_t hostWaitNanoseconds() const noexcept { return m_hostWaitNs; }
@@ -516,6 +521,9 @@ private:
     BoundaryHook m_boundaryHook;
     bool m_cycleOrderedEvents = false;
     uint64_t m_hostWaitNs = 0;
+    std::vector<uint32_t> m_idleLoopPcs;
+    uint64_t m_idleSkippedCycles = 0;
+    void skipIdleIterations(uint32_t cycles) noexcept;
     bool m_mainWakePending = false;
     bool m_vblankPending = false;
     EeWaitReason m_mainWakeReason = EeWaitReason::None;
