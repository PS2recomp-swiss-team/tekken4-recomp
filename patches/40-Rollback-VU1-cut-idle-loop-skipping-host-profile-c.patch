 }
 
+void EeScheduler::skipIdleIterations(uint32_t cycles) noexcept
+{
+    const GuestThread *running = currentThread();
+    if (!running || m_pendingEeTimerInterrupts != 0u || m_checkpointPending.load(std::memory_order_acquire))
+        return;
+    if (!running->invocations.empty()) // an interrupt handler runs: not the idle loop
+        return;
+    const uint32_t pc = running->context.pc;
+    if (std::find(m_idleLoopPcs.begin(), m_idleLoopPcs.end(), pc) == m_idleLoopPcs.end())
+        return;
+    // Iteration k of the loop ends at m_eeCycle + k * step; the first one reaching a limit must run normally.
+    uint64_t limit = m_sliceEndCycle > m_eeCycle ? m_sliceEndCycle - m_eeCycle : 0u;
+    const uint64_t nextEventCycle = m_nextDeadlineCycle.load(std::memory_order_acquire);
+    if (nextEventCycle != 0u)
+        limit = std::min<uint64_t>(limit, nextEventCycle > m_eeCycle ? nextEventCycle - m_eeCycle : 0u);
+    limit = std::min<uint64_t>(limit, m_runtime.memory().cyclesUntilNextEeTimerInterrupt());
+    const uint64_t step = std::max<uint64_t>(1u, cycles);
+    if (limit <= step)
+        return;
+    const uint64_t iterations = (limit - 1u) / step;
+    const uint64_t bulk = std::min<uint64_t>(iterations * step, 0x7FFFFFFFu);
+    if (bulk == 0u)
+        return;
+    m_idleSkippedCycles += bulk;
+    accountCycles(static_cast<uint32_t>(bulk));
+}
+
 void EeScheduler::accountCycles(uint32_t cycles) noexcept
 {
     const uint64_t elapsed = std::max<uint64_t>(1u, cycles);
