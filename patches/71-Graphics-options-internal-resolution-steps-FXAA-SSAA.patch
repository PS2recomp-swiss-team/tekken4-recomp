+// Tekken 4 port (PC graphics options, docs/GRAPHICS.md): how the presented picture is scaled to the window.
+// TEKKEN4_WINDOW_FILTER=area (default: area average when the picture is larger than the window, i.e. supersampling at
+// a high internal resolution; bilinear when it is smaller) | sharp (sharp bilinear when enlarging: crisp pixels, smooth
+// steps) | bilinear | nearest. A plain bilinear/nearest shrink of a 4K picture into a smaller window aliases and shimmers.
+static const char *kWindowFilterFs = R"(#version 330
+in vec2 fragTexCoord;
+in vec4 fragColor;
+uniform sampler2D texture0;
+uniform vec2 srcSize;
+uniform vec2 dstSize;
+uniform int mode; // 0 area/bilinear, 1 sharp, 2 bilinear, 3 nearest
+out vec4 finalColor;
+void main()
+{
+    vec2 ratio = srcSize / dstSize; // picture pixels per window pixel
+    vec2 p = fragTexCoord * srcSize;
+    if (mode == 3)
+    {
+        finalColor = texelFetch(texture0, ivec2(clamp(floor(p), vec2(0.0), srcSize - 1.0)), 0);
+        return;
+    }
+    if (mode == 0 && (ratio.x > 1.0 || ratio.y > 1.0))
+    {
+        ivec2 n = ivec2(clamp(ceil(ratio) + 1.0, 1.0, 8.0));
+        vec2 lo = p - 0.5 * ratio;
+        vec4 sum = vec4(0.0);
+        for (int y = 0; y < n.y; ++y)
+            for (int x = 0; x < n.x; ++x)
+                sum += texture(texture0, (lo + (vec2(x, y) + 0.5) * ratio / vec2(n)) / srcSize);
+        finalColor = vec4(sum.rgb / float(n.x * n.y), 1.0);
+        return;
+    }
+    if (mode == 1)
+    {
+        vec2 f = p - 0.5;
+        vec2 fl = floor(f);
+        p = fl + clamp((f - fl - 0.5) * max(1.0 / ratio, vec2(1.0)) + 0.5, 0.0, 1.0) + 0.5;
+    }
+    finalColor = texture(texture0, p / srcSize);
+}
+)";
