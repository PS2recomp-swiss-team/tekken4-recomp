From 8f5b93b1ced3a9b319c5aab8914e0ab5d4ea64e5 Mon Sep 17 00:00:00 2001
From: Tommy <tommy@pham.cc>
Date: Thu, 29 Oct 2026 01:54:33 +0100
Subject: [PATCH 1/3] SIF: EE sceSifSendCmd payload ($t0/$t1) to IOP RAM,
 packet to the IOP module's handler

EE sceSifSendCmd(cid, packet, psize, src, dest, size): on the EE ABI dest and size arrive in
$t0/$t1. ps2_syscalls::sceSifSendCmd read them from the stack and copied into EE RAM, so the
IOP never saw the payload, and the IOP sifcmd HLE dropped sceSifAddCmdHandler, so no module saw
the packet. Now the payload is written to IOP RAM and the packet is queued
(ps2x::iop::queueEeSifCommand); the IOP calls the handler registered for cid (sound route only)
at its next scheduling point, with the SIF header words (size | dsize << 8, dest, cid).
Tekken 4's zsiopdrv pulls sound data from EE RAM this way (its cid 2 requests, cid 0 answers).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ps2xIOP/include/ps2x/iop/iop_host.h         |   6 +
 ps2xIOP/src/emulator/iop_emulator.cpp       | 149 ++++++++++++++++++++
 ps2xRuntime/src/lib/Kernel/Stubs/SIF.cpp    |  27 +---
 ps2xRuntime/src/lib/Kernel/Syscalls/RPC.cpp |  56 ++++++--
 4 files changed, 198 insertions(+), 40 deletions(-)

diff --git a/ps2xIOP/include/ps2x/iop/iop_host.h b/ps2xIOP/include/ps2x/iop/iop_host.h
index 289bc33..b26c3e3 100644
--- a/ps2xIOP/include/ps2x/iop/iop_host.h
+++ b/ps2xIOP/include/ps2x/iop/iop_host.h
@@ -153,4 +153,10 @@ namespace ps2x::iop
     // GetSreg/SetSreg (ordinals 6/7) read the same store. zsiopdrv spins until register 31 is non-zero.
     void setSifSoftwareRegister(uint32_t index, uint32_t value) noexcept;
     uint32_t sifSoftwareRegister(uint32_t index) noexcept;
+
+    // EE -> IOP SIF commands (EE sceSifSendCmd). The runtime copies the command's extra payload into IOP RAM first
+    // (the SIF DMA lands before the packet); the IOP then calls the handler its module registered for cid with
+    // sceSifAddCmdHandler, at its next scheduling point (on a console: the IOP's SIF DMA interrupt). packet is the
+    // whole command packet (16-byte header + body, 16..112 bytes). Commands without a registered handler are dropped.
+    void queueEeSifCommand(uint32_t cid, const void *packet, uint32_t size) noexcept;
 }
