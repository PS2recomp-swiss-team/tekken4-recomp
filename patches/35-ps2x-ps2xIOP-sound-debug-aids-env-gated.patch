+        // TEKKEN4_SOUND_VOICES=1: every 5 mixer seconds, every sounding voice (debug aid for the BGM stream voices).
+        static const bool voiceList = std::getenv("TEKKEN4_SOUND_VOICES") != nullptr;
+        if (voiceList)
+        {
+            static uint64_t mixSamples = 0;
+            if (++mixSamples % (48000u * 5u) == 0u)
+            {
+                std::fprintf(stderr, "[snd-voices] t=%llus mvol0=%04x/%04x mvol1=%04x/%04x attr=%04x/%04x irqa=%x/%x rev=%d/%d\n",
