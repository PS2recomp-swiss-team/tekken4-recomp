From 8775a272f47e4a02990e720f46b01c8dd1a91e70 Mon Sep 17 00:00:00 2001
From: Tommy <tommy@pham.cc>
Date: Fri, 30 Oct 2026 03:20:58 +0100
Subject: [PATCH 63/65] Run-ahead pauses while a movie uses the MPEG decoder

The host MPEG decoder is not in the snapshot: speculative frames advanced it
and the restore left the guest behind (intro movie stuck with run-ahead on).
Any MPEG stub call now pauses run-ahead (plain real frames, normal present)
until 30 real frames have passed without one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ps2xRuntime/include/runtime/ps2_runahead.h |  3 ++
 ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp  | 10 +++++++
 ps2xRuntime/src/lib/ps2_runahead.cpp       | 33 ++++++++++++++++++++++
 3 files changed, 46 insertions(+)

diff --git a/ps2xRuntime/include/runtime/ps2_runahead.h b/ps2xRuntime/include/runtime/ps2_runahead.h
index 388a00f..a467184 100644
--- a/ps2xRuntime/include/runtime/ps2_runahead.h
+++ b/ps2xRuntime/include/runtime/ps2_runahead.h
@@ -26,6 +26,9 @@ namespace ps2_runahead
     bool active() noexcept;
     // Bumped after every latch run-ahead made; the presenter copies the latched picture when it changes.
     uint64_t latchSequence() noexcept;
+    // EE thread: a stub used host-side state the snapshot does not hold (the MPEG decoder): run-ahead pauses
+    // until 30 real frames have passed without such a call.
+    void noteHostState() noexcept;
     // A speculative frame is running: pad reads must not consume latched taps.
     bool speculative() noexcept;
 }
