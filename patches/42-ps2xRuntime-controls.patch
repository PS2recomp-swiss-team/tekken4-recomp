+            if ((name[0] == 'K' || name[0] == 'k') && (name[1] == 'E' || name[1] == 'e') &&
+                (name[2] == 'Y' || name[2] == 'y') && name[3] == '_')
+                name += 4;
+            for (const KeyInfo &info : kKeys)
+            {
+                if (sameName(info.name, name))
+                    return &info;
+            }
+            return nullptr;
+        }
+
+        const KeyInfo *findKeyCode(int raylib)
+        {
