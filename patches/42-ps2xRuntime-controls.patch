+            for (int i = 0; i < count; ++i)
+            {
+                const char *name = keyName(keys[i]);
+                if (!name)
+                    continue;
+                const int n = std::snprintf(dst + used, static_cast<std::size_t>(cap - used), "%s%s",
+                                            used ? "," : "", name);
+                if (n < 0 || used + n >= cap)
+                {
+                    dst[0] = '\0';
+                    return;
+                }
+                used += n;
+            }
+        }
+
+        void formatGpList(const int *src, int count, char *dst, int cap)
