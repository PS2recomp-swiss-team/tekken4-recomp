+        bool parseUnit(const char *text, float &out)
+        {
+            if (!text || !text[0])
+                return false;
+            char buf[64];
+            std::snprintf(buf, sizeof(buf), "%s", text);
+            trimInPlace(buf);
+            for (char *p = buf; *p; ++p)
+            {
+                if (*p == ',')
+                    *p = '.';
+            }
+            char *end = nullptr;
+            const float v = std::strtof(buf, &end);
+            if (end == buf)
+                return false;
+            while (*end == ' ' || *end == '\t')
+                ++end;
+            if (*end != '\0')
+                return false;
+            out = v;
+            return true;
+        }
+
+        void formatUnit(char *dst, int cap, float v)
+        {
+            if (!(v > -10.f && v < 10.f))
+                v = 0.f;
+            const bool neg = v < 0.f;
+            const float mag = neg ? -v : v;
+            int milli = static_cast<int>(std::lround(mag * 1000.f));
+            if (milli < 0)
+                milli = 0;
+            std::snprintf(dst, static_cast<std::size_t>(cap), "%s%d.%03d", neg ? "-" : "", milli / 1000, milli % 1000);
+        }
+
+        bool parseList(const char *text, int *out, int max, int &count, bool keys)
+        {
+            count = 0;
+            if (!text)
+                return false;
+            char buf[192];
+            std::snprintf(buf, sizeof(buf), "%s", text);
+            trimInPlace(buf);
+            if (buf[0] == '\0')
+                return true;
+            char *cursor = buf;
+            while (*cursor)
+            {
+                while (*cursor == ' ' || *cursor == '\t' || *cursor == ',')
+                    ++cursor;
+                if (!*cursor)
+                    break;
+                char *start = cursor;
+                while (*cursor && *cursor != ',')
+                    ++cursor;
+                if (*cursor == ',')
+                {
+                    *cursor = '\0';
+                    ++cursor;
+                }
+                trimInPlace(start);
+                if (!start[0])
+                    continue;
+                if (count >= max)
+                    return false;
+                if (keys)
+                {
+                    const KeyInfo *info = findKeyName(start);
+                    if (!info)
+                        return false;
+                    out[count++] = info->raylib;
+                }
+                else
+                {
+                    int src = 0;
+                    if (!findGpName(start, src))
+                        return false;
+                    out[count++] = src;
+                }
+            }
+            return true;
+        }
+
+        void formatKeyList(const int *keys, int count, char *dst, int cap)
+        {
