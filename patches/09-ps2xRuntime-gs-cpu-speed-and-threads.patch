+void GSCpuBackend::StartWorkersIfConfigured()
+{
+    m_workersConfigured = true;
+    const char *setting = std::getenv("PS2X_GS_THREADS");
+    if (!setting)
+        return;
+    unsigned count = static_cast<unsigned>(std::strtoul(setting, nullptr, 10));
+    if (std::strcmp(setting, "auto") == 0)
+    {
+        const unsigned hardware = std::thread::hardware_concurrency();
+        count = hardware > 2u ? hardware - 2u : 0u; // leave the EE and the window thread a core each
+    }
+    if (count < 2u)
+        return;
+    count = std::min(count, 16u);
+    m_bandCount = count;
+    m_stopWorkers = false;
+    m_workerNext.assign(count, 0u);
+    m_workerCaches.clear();
+    for (unsigned i = 0; i < count; ++i)
+        m_workerCaches.push_back(std::make_unique<GSMem::TexturePageCache>());
+    for (unsigned i = 0; i < count; ++i)
+        m_workers.emplace_back([this, i]() { WorkerLoop(i); });
+}
+
+void GSCpuBackend::StopWorkers()
+{
+    if (m_workers.empty())
+        return;
+    {
+        std::lock_guard<std::mutex> jobLock(m_jobMutex);
+        m_stopWorkers = true;
+    }
+    m_jobCv.notify_all();
+    for (std::thread &worker : m_workers)
+        worker.join();
+    m_workers.clear();
+    m_jobs.clear();
+}
+
+void GSCpuBackend::WaitForWorkersUnlocked() const
+{
+    if (m_workers.empty())
+        return;
+    std::unique_lock<std::mutex> jobLock(m_jobMutex);
+    m_idleCv.wait(jobLock, [this]()
+                  {
+                      for (const size_t next : m_workerNext)
+                          if (next != m_jobs.size())
+                              return false;
+                      return true; });
+    m_jobs.clear();
+    std::fill(m_workerNext.begin(), m_workerNext.end(), 0u);
+    m_queuedWritePages.clear();
+    m_queuedReadPages.clear();
+    // Each one-page texture cache may hold a page that was uploaded or drawn to since: start fresh (with workers
+    // the EE thread's own cache serves only CLUT loads, so it would otherwise stay stale for a long time).
+    for (const auto &cache : m_workerCaches)
+        cache->Invalidate();
