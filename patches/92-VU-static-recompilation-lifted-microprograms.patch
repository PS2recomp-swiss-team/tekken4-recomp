 endif()
 
+# Tekken 4 port (t4vurecomp): statically recompiled VU microprograms. PS2X_VULIFT_GEN = tools/vu/vu_lift.py of the
+# Tekken 4 repo; it reads the VU1 micro memory folder above (PS2X_VU1_MICROCODE_DIR) and, when set, the VU0 one
+# (PS2X_VU0_MICROCODE_DIR), and writes vulift_part0..3.cpp into the build folder (game code: never published).
+# Without them every program runs in the exact engine (or the native blocks above).
+set(PS2X_VULIFT_GEN "" CACHE FILEPATH "VU microprogram lifter (tools/vu/vu_lift.py)")
+set(PS2X_VU0_MICROCODE_DIR "" CACHE PATH "VU0 micro memories (empty: VU0 in the exact engine)")
+if(PS2X_VULIFT_GEN AND EXISTS "${PS2X_VULIFT_GEN}" AND NOT PS2X_IS_ANDROID AND NOT PS2X_IS_VITA)
+    find_package(Python3 COMPONENTS Interpreter)
+    set(PS2X_VULIFT_IMAGES)
+    set(PS2X_VULIFT_ARGS)
+    if(PS2X_VU1_MICROCODE_DIR)
+        file(GLOB PS2X_VULIFT_VU1 CONFIGURE_DEPENDS "${PS2X_VU1_MICROCODE_DIR}/*.bin")
+        list(APPEND PS2X_VULIFT_IMAGES ${PS2X_VULIFT_VU1})
+        list(APPEND PS2X_VULIFT_ARGS --vu1 "${PS2X_VU1_MICROCODE_DIR}")
+    endif()
+    if(PS2X_VU0_MICROCODE_DIR)
+        file(GLOB PS2X_VULIFT_VU0 CONFIGURE_DEPENDS "${PS2X_VU0_MICROCODE_DIR}/*.bin")
+        list(APPEND PS2X_VULIFT_IMAGES ${PS2X_VULIFT_VU0})
+        list(APPEND PS2X_VULIFT_ARGS --vu0 "${PS2X_VU0_MICROCODE_DIR}")
+    endif()
+    if(PS2X_VULIFT_IMAGES AND Python3_FOUND)
+        get_filename_component(PS2X_VULIFT_TOOLDIR "${PS2X_VULIFT_GEN}" DIRECTORY)
+        set(PS2X_VULIFT_DIR "${CMAKE_CURRENT_BINARY_DIR}/vulift_generated")
+        set(PS2X_VULIFT_PARTS)
+        foreach(part RANGE 0 3)
+            list(APPEND PS2X_VULIFT_PARTS "${PS2X_VULIFT_DIR}/vulift_part${part}.cpp")
+        endforeach()
+        set(PS2X_VULIFT_HEADS "${PS2X_VU1_MICROCODE_DIR}/../vulift_heads.txt")
+        set(PS2X_VULIFT_HEADS_DEP)
+        if(EXISTS "${PS2X_VULIFT_HEADS}")
+            set(PS2X_VULIFT_HEADS_DEP "${PS2X_VULIFT_HEADS}")
+        endif()
+        add_custom_command(OUTPUT ${PS2X_VULIFT_PARTS}
+            COMMAND "${CMAKE_COMMAND}" -E make_directory "${PS2X_VULIFT_DIR}"
+            COMMAND "${Python3_EXECUTABLE}" -I "${PS2X_VULIFT_GEN}" "${PS2X_VULIFT_DIR}" ${PS2X_VULIFT_ARGS} --parts 4
+                    --heads "${PS2X_VULIFT_HEADS}" --report "${PS2X_VULIFT_DIR}/vulift_report.txt"
+            DEPENDS "${PS2X_VULIFT_GEN}" "${PS2X_VULIFT_TOOLDIR}/vu_isa.py" ${PS2X_VULIFT_IMAGES} ${PS2X_VULIFT_HEADS_DEP}
+            VERBATIM)
+        target_sources(ps2EntryRunner PRIVATE ${PS2X_VULIFT_PARTS})
+        set_source_files_properties(${PS2X_VULIFT_PARTS} PROPERTIES
+            SKIP_UNITY_BUILD_INCLUSION ON
+            SKIP_PRECOMPILE_HEADERS ON)
+        if(MSVC)
+            set_source_files_properties(${PS2X_VULIFT_PARTS} PROPERTIES COMPILE_OPTIONS "/bigobj")
+        endif()
+        message(STATUS "VU lifter: ${PS2X_VULIFT_IMAGES}")
+    endif()
+endif()
+
 if(PS2X_ENABLE_DEBUG_UI AND NOT PS2X_IS_VITA AND NOT PS2X_IS_ANDROID)
     target_sources(ps2EntryRunner PRIVATE
         src/lib/ps2_debug_panel.cpp
