     }
 
+    if (!needsLatch && s_lastRunaheadLatch != ps2_runahead::latchSequence())
+        ps2_input_latency::onLatchBegin(currentTick); // the speculative picture counts as this tick's latch
+    s_lastRunaheadLatch = ps2_runahead::latchSequence();
     s_scratch.clear();
     uint32_t width = 0u;
     uint32_t height = 0u;
@@ -2482,6 +2492,7 @@ void PS2Runtime::run()
     std::atomic<bool> gameThreadFinished{false};
     ps2_perf_stats::start(*this);
 
+    ps2_runahead::install(*this); // after the game overrides installed their boundary hooks
     std::thread gameThread([&]()
