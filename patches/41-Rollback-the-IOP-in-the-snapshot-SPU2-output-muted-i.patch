         class Impl;
         std::unique_ptr<Impl> m_impl;
diff --git a/ps2xIOP/src/emulator/core/iop_kernel.cpp b/ps2xIOP/src/emulator/core/iop_kernel.cpp
index 7695347..233218a 100644
--- a/ps2xIOP/src/emulator/core/iop_kernel.cpp
+++ b/ps2xIOP/src/emulator/core/iop_kernel.cpp
@@ -108,6 +108,52 @@ namespace ps2x::iop::detail
     {
     }
 
+    void IopKernel::saveState(SavedState &out) const
+    {
+        out.threads = m_threads;
+        out.links.clear();
+        for (const auto &[id, thread] : m_threads)
+            out.links[id] = {thread.readyLink ? thread.readyLink->id : 0, thread.delayLink ? thread.delayLink->id : 0};
+        out.semaphores = m_semaphores;
+        out.eventFlags = m_eventFlags;
+        out.nextThreadId = m_nextThreadId;
+        out.nextSemaphoreId = m_nextSemaphoreId;
+        out.nextEventFlagId = m_nextEventFlagId;
+        out.currentId = m_currentThread ? m_currentThread->id : 0;
+        out.readyHeadId = m_readyHead ? m_readyHead->id : 0;
+        out.delayHeadId = m_delayHead ? m_delayHead->id : 0;
+        out.nextDelayWake = m_nextDelayWake;
+        out.schedEpoch = m_schedEpoch;
+    }
+
+    void IopKernel::loadState(const SavedState &in)
+    {
+        m_threads = in.threads;
+        const auto byId = [this](int id) -> IopThread *
+        {
+            if (id == 0)
+                return nullptr;
+            const auto it = m_threads.find(id);
+            return it == m_threads.end() ? nullptr : &it->second;
+        };
+        for (auto &[id, thread] : m_threads)
+        {
+            const auto link = in.links.find(id);
+            thread.readyLink = link == in.links.end() ? nullptr : byId(link->second.first);
+            thread.delayLink = link == in.links.end() ? nullptr : byId(link->second.second);
+        }
+        m_semaphores = in.semaphores;
+        m_eventFlags = in.eventFlags;
+        m_nextThreadId = in.nextThreadId;
+        m_nextSemaphoreId = in.nextSemaphoreId;
+        m_nextEventFlagId = in.nextEventFlagId;
+        m_currentThread = byId(in.currentId);
+        m_readyHead = byId(in.readyHeadId);
+        m_delayHead = byId(in.delayHeadId);
+        m_nextDelayWake = in.nextDelayWake;
+        m_schedEpoch = in.schedEpoch;
+    }
+
     void IopKernel::reset()
     {
         m_readyHead = nullptr;
diff --git a/ps2xIOP/src/emulator/core/iop_kernel.h b/ps2xIOP/src/emulator/core/iop_kernel.h
index 06290e4..89283a0 100644
--- a/ps2xIOP/src/emulator/core/iop_kernel.h
+++ b/ps2xIOP/src/emulator/core/iop_kernel.h
@@ -117,5 +117,21 @@ namespace ps2x::iop::detail
         IopThread *m_delayHead = nullptr;
         uint64_t m_nextDelayWake = ~uint64_t{0};
         uint64_t m_schedEpoch = 0;
+
+    public:
+        // Rollback: threads (with their CPU states), kernel objects, queues (links kept as thread ids).
+        struct SavedState
+        {
+            std::map<int, IopThread> threads;
+            std::map<int, std::pair<int, int>> links; // thread id -> (ready link id, delay link id), 0 = none
+            std::map<int, Semaphore> semaphores;
+            std::map<int, EventFlag> eventFlags;
+            uint32_t nextThreadId = 1, nextSemaphoreId = 1, nextEventFlagId = 1;
+            int currentId = 0, readyHeadId = 0, delayHeadId = 0;
+            uint64_t nextDelayWake = ~uint64_t{0};
+            uint64_t schedEpoch = 0;
+        };
+        void saveState(SavedState &out) const;
+        void loadState(const SavedState &in);
     };
 }
diff --git a/ps2xIOP/src/emulator/core/iop_memory.cpp b/ps2xIOP/src/emulator/core/iop_memory.cpp
index 15aa197..0e614c1 100644
--- a/ps2xIOP/src/emulator/core/iop_memory.cpp
+++ b/ps2xIOP/src/emulator/core/iop_memory.cpp
@@ -31,6 +31,42 @@ namespace ps2x::iop::detail
         reset();
     }
 
+    void IopMemory::saveState(SavedState &out) const
+    {
+        out.ram.assign(m_ram.begin(), m_ram.end());
+        out.owned.assign(m_owned.begin(), m_owned.end());
+        out.scratch.assign(m_scratch.begin(), m_scratch.end());
+        out.hardware = m_hardware;
+        out.allocations = m_allocations;
+        out.heapCursor = m_heapCursor;
+        out.heapFloor = m_heapFloor;
+        out.topDown = m_topDown;
+        out.interruptStatus = m_interruptStatus;
+        out.interruptMask = m_interruptMask;
+        out.interruptControl = m_interruptControl;
+        out.dmaStart = m_dmaStart;
+    }
+
+    void IopMemory::loadState(const SavedState &in)
+    {
+        // Same sizes: copied in place, so pointers into RAM (the SPU2 stream rings) stay valid.
+        if (in.ram.size() == m_ram.size())
+            std::copy(in.ram.begin(), in.ram.end(), m_ram.begin());
+        if (in.owned.size() == m_owned.size())
+            std::copy(in.owned.begin(), in.owned.end(), m_owned.begin());
+        if (in.scratch.size() == m_scratch.size())
+            std::copy(in.scratch.begin(), in.scratch.end(), m_scratch.begin());
+        m_hardware = in.hardware;
+        m_allocations = in.allocations;
+        m_heapCursor = in.heapCursor;
+        m_heapFloor = in.heapFloor;
+        m_topDown = in.topDown;
+        m_interruptStatus = in.interruptStatus;
+        m_interruptMask = in.interruptMask;
+        m_interruptControl = in.interruptControl;
+        m_dmaStart = in.dmaStart;
+    }
+
     void IopMemory::reset()
     {
         std::fill(m_ram.begin(), m_ram.end(), uint8_t{0});
