+
+    public:
+        // Rollback (ps2x::iop::IopSnapshot): every member above, by value.
+        struct SavedState
+        {
+            std::vector<uint8_t> ram, owned, scratch;
+            std::unordered_map<uint32_t, uint32_t> hardware;
+            std::vector<Allocation> allocations;
+            uint32_t heapCursor = 0, heapFloor = 0;
+            bool topDown = false;
+            uint32_t interruptStatus = 0, interruptMask = 0, interruptControl = 0;
+            std::optional<DmaStart> dmaStart;
+        };
+        void saveState(SavedState &out) const;
+        void loadState(const SavedState &in);
     };
 }
