+            }
+            else if (maskSpec == 2u)
+            {
+                writeVal = u.col[colIdx];
+            }
+            else
+            {
+                continue; // write-protect
+            }
+
+            lanes[field] = writeVal;
+        }
+
+        std::memcpy(vu1 + destOff, lanes, sizeof(lanes));
+    }
