diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index 013bcc2..fe8e499 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -14,6 +14,11 @@ if(PS2X_SIMD_BASELINE AND MSVC)
     add_compile_definitions(PS2X_SIMD_BASELINE)
     add_compile_options("$<$<COMPILE_LANGUAGE:CXX>:/FI${CMAKE_CURRENT_SOURCE_DIR}/include/ps2_simd_baseline.h>")
 endif()
+# Tekken 4 port (0.1.3, bundled clang-cl): MSVC compiles the SSE4.1/SSSE3 intrinsics without an /arch switch, clang
+# needs the target feature. Never with PS2X_SIMD_BASELINE (SSE2-only PCs: those intrinsics are replaced there).
+if(NOT PS2X_SIMD_BASELINE AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
+    add_compile_options(-msse4.1)
+endif()
 option(PS2X_ENABLE_RUNNER_PCH "Precompile the heavy runtime headers for ps2EntryRunner" ON)
 option(PS2X_ENABLE_SCCACHE "Use sccache as compiler launcher when available" ON)
 
