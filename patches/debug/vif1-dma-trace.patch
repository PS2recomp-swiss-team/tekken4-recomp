+                     static_cast<unsigned long long>(inRam ? e.source - ram : e.source), e.pos, e.size);
+    }
+    for (unsigned k = 0; k < 16u; ++k)
+    {
+        const Vif1ModeEntry &m = g_vif1Modes[(g_vif1ModesNext + k) % 16u];
+        if (m.cmd == 0u)
+            continue;
+        std::fprintf(stderr, "[vif1-trace] STMOD cmd=%08x (code before: %08x) %llu VIF codes ago src=host:%llx pos=%x/%x\n", m.cmd,
+                     m.previousCmd, static_cast<unsigned long long>(g_vif1CodeCount - m.codeIndex),
+                     static_cast<unsigned long long>(m.source), m.pos, m.size);
+    }
