+void ps2DmaTagTraceDump(const uint8_t *rdram)
+{
+    uint32_t lastStartTadr = 0u; // the raw ring around the last VIF1 start's TADR (compare with a PCSX2 ring dump)
+    for (unsigned k = 0u; k < 4096u; ++k)
+    {
+        const DmaTagTraceEntry &e = g_dmaTagTrace[(g_dmaTagTraceNext + k) % 4096u];
+        if (e.path == 'S')
+            lastStartTadr = e.tagAddr;
+    }
+    if (rdram && lastStartTadr >= 0x200u)
+        for (uint32_t a = lastStartTadr - 0x100u; a < lastStartTadr + 0x200u; a += 16u)
+        {
+            uint64_t lo = 0, hi = 0;
+            std::memcpy(&lo, rdram + (a & (PS2_RAM_SIZE - 1u)), 8);
+            std::memcpy(&hi, rdram + ((a + 8u) & (PS2_RAM_SIZE - 1u)), 8);
+            std::fprintf(stderr, "[vif1-bad]   ring %08x: %016llx %016llx\n", a, static_cast<unsigned long long>(lo),
+                         static_cast<unsigned long long>(hi));
+        }
+    unsigned first = 0u; // from 40 events before the last drain that reached END / REFE
+    for (unsigned k = 0u; k < 4096u; ++k)
+    {
+        const DmaTagTraceEntry &e = g_dmaTagTrace[(g_dmaTagTraceNext + k) % 4096u];
+        if (e.path == 'E' && (e.tag & 1u) != 0u)
+            first = k >= 40u ? k - 40u : 0u;
+    }
+    for (unsigned k = first; k < 4096u; ++k)
+    {
+        const DmaTagTraceEntry &e = g_dmaTagTrace[(g_dmaTagTraceNext + k) % 4096u];
+        if (e.path == 0)
+            continue;
+        if (e.path == 'E')
+        {
+            std::fprintf(stderr, "[vif1-bad]   drain done: TADR=%08x ring write pos=%08x %s, %x bytes\n", e.tagAddr,
+                         static_cast<unsigned>(e.tag >> 32), (e.tag & 1u) ? "ENDED" : "waiting", e.outBytes);
+            continue;
+        }
+        if (e.path == 'F')
+        {
+            std::fprintf(stderr, "[vif1-bad]   fromSPR to ring %08x: qwc=%x from SPR %04x (ends %08x)\n", e.tagAddr,
+                         static_cast<unsigned>(e.tag >> 32), static_cast<unsigned>(e.tag & 0xFFFFu), e.tagAddr + e.outBytes);
+            continue;
+        }
+        if (e.path == 'R')
+        {
+            std::fprintf(stderr, "[vif1-bad]     next tag at TADR %08x: id=%u qwc=%x addr=%08x (%x bytes written after TADR)\n",
+                         e.tagAddr, static_cast<unsigned>((e.tag >> 28) & 7u), static_cast<unsigned>(e.tag & 0xFFFFu),
+                         static_cast<unsigned>((e.tag >> 32) & 0x7FFFFFF0u), e.outBytes);
+            continue;
+        }
+        if (e.path == 'I')
+        {
+            std::fprintf(stderr, "[vif1-bad]   ignored CHCR write %08x = %08x (channel waiting on MFIFO)\n", e.tagAddr,
+                         static_cast<unsigned>(e.tag));
+            continue;
+        }
+        if (e.path == 'W')
+        {
+            std::fprintf(stderr, "[vif1-bad]   EE writes %08x = %08x\n", e.tagAddr, static_cast<unsigned>(e.tag & 0xFFFFFFFFu));
+            continue;
+        }
+        if (e.path == 'S')
+        {
+            std::fprintf(stderr, "[vif1-bad]   VIF1 start: CHCR=%08x TADR=%08x QWC=%x D_CTRL=%08x (MFD=%u)\n",
+                         static_cast<unsigned>(e.tag & 0xFFFFFFFFu), e.tagAddr, e.outBytes,
+                         static_cast<unsigned>(e.tag >> 32), static_cast<unsigned>((e.tag >> 34) & 3u));
+            continue;
+        }
+        std::fprintf(stderr, "[vif1-bad]   tag %c at %08x: id=%u qwc=%x addr=%08x (buffer had %x bytes)\n", e.path, e.tagAddr,
+                     static_cast<unsigned>((e.tag >> 28) & 7u), static_cast<unsigned>(e.tag & 0xFFFFu),
+                     static_cast<unsigned>((e.tag >> 32) & 0x7FFFFFF0u), e.outBytes);
+    }
+}
