+    out.eeTimerDebt = m_eeTimerDebt;
+    out.eeTimerLimit = m_eeTimerLimit;
+    out.latchedTimerIrq = m_latchedTimerIrq;
+    out.gifFqcPending = m_gifFqcPending;
+    out.mfifoDraining = m_mfifoDraining;
+    out.mfifoWaitingChannel = m_mfifoWaitingChannel;
+}
