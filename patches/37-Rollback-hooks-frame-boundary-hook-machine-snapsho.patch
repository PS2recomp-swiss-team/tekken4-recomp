+    void copyGsRegsOut(const GSRegisters &regs, uint64_t (&out)[20])
+    {
+        out[0] = regs.pmode;
+        out[1] = regs.smode1;
+        out[2] = regs.smode2;
+        out[3] = regs.srfsh;
+        out[4] = regs.synch1;
+        out[5] = regs.synch2;
+        out[6] = regs.syncv;
+        out[7] = regs.dispfb1;
+        out[8] = regs.display1;
+        out[9] = regs.dispfb2;
+        out[10] = regs.display2;
+        out[11] = regs.extbuf;
+        out[12] = regs.extdata;
+        out[13] = regs.extwrite;
+        out[14] = regs.bgcolor;
+        out[15] = regs.csr.load(std::memory_order_acquire);
+        out[16] = regs.vsyncTick.load(std::memory_order_acquire);
+        out[17] = regs.imr;
+        out[18] = regs.busdir;
+        out[19] = regs.siglblid;
