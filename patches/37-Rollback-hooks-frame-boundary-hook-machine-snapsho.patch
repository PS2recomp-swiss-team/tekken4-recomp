+{
+    // vblank: a VBlankStart was processed since the last call (the hook then also runs while a thread is
+    // Running: it was stopped at a checkpoint, its resume pc is in its context and the host stack is unwound).
+    bool vblank = false;
+    int runningThreadId = 0;
+    EeWaitReason reason = EeWaitReason::None;
+    int waitId = 0;
+    uint64_t vsyncTick = 0;
