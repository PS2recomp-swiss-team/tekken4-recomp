+
+    void copyGsRegsIn(GSRegisters &regs, const uint64_t (&in)[20])
+    {
+        regs.pmode = in[0];
+        regs.smode1 = in[1];
+        regs.smode2 = in[2];
+        regs.srfsh = in[3];
+        regs.synch1 = in[4];
