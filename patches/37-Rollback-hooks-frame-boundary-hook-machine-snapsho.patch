+    out.seenGifCopy = m_seenGifCopy;
+    out.path3Masked = m_path3Masked;
+    out.path2CutTagLo = m_path2CutTagLo;
+    out.path2CutTagHi = m_path2CutTagHi;
+    out.path2CutDoneRegs = m_path2CutDoneRegs;
+    out.path2CutRemainingBytes = m_path2CutRemainingBytes;
+    out.path2CutDirectHl = m_path2CutDirectHl;
+    out.vif1Carry = m_vif1Carry;
+    out.path3MaskedFifo = m_path3MaskedFifo;
+    copyPending(m_pendingGifTransfers, out.pendingGif);
+    copyPending(m_pendingVif0Transfers, out.pendingVif0);
+    copyPending(m_pendingVif1Transfers, out.pendingVif1);
+    {
+        std::lock_guard<std::mutex> lock(m_completedDmacMutex);
+        out.completedDmacCauses = m_completedDmacCauses;
