+
+void EeScheduler::saveState(SavedState &out) const
+{
+    assertExecutor();
+    out.readyQueues = m_readyQueues;
+    out.threads = m_threads;
+    out.semaphores = m_semaphores;
+    out.eventFlags = m_eventFlags;
+    out.alarms = m_alarms;
+    out.intcHandlers = m_intcHandlers;
+    out.dmacHandlers = m_dmacHandlers;
+    out.nextThreadId = m_nextThreadId;
+    out.nextInvocationThreadId = m_nextInvocationThreadId;
+    out.nextSemaphoreId = m_nextSemaphoreId;
+    out.nextEventFlagId = m_nextEventFlagId;
+    out.nextAlarmId = m_nextAlarmId;
+    out.nextIntcHandlerId = m_nextIntcHandlerId;
+    out.nextDmacHandlerId = m_nextDmacHandlerId;
+    out.intcHeadOrder = m_intcHeadOrder;
+    out.intcTailOrder = m_intcTailOrder;
+    out.dmacHeadOrder = m_dmacHeadOrder;
+    out.dmacTailOrder = m_dmacTailOrder;
+    out.enabledIntcMask = m_enabledIntcMask;
+    out.enabledDmacMask = m_enabledDmacMask;
+    out.currentThreadId = m_currentThreadId;
+    out.rescheduleRequested = m_rescheduleRequested;
+    out.timeSliceExpired = m_timeSliceExpired;
+    out.insideInterrupt = m_insideInterrupt;
+    out.checkpointPending = m_checkpointPending.load(std::memory_order_acquire);
+    out.pendingEeTimerInterrupts = m_pendingEeTimerInterrupts;
+    out.eeCycle = m_eeCycle;
+    out.sliceEndCycle = m_sliceEndCycle;
+    {
+        std::lock_guard lock(m_eventMutex);
+        out.events = m_events;
+        out.deadlines = m_deadlines;
+    }
+    out.pendingInvocations = m_pendingInvocations;
+    out.eventSequence = m_eventSequence;
+    out.invocationSequence = m_invocationSequence;
+    out.vsyncTick = m_vsyncTick;
+    out.vsyncFlagAddress = m_vsyncFlagAddress;
+    out.vsyncTickAddress = m_vsyncTickAddress;
+    out.gsVSyncCallback = m_gsVSyncCallback;
+    out.gsVSyncCallbackGp = m_gsVSyncCallbackGp;
+    out.gsVSyncCallbackSp = m_gsVSyncCallbackSp;
+    out.invocationStackTops = m_invocationStackTops;
+    out.mainWakePending = m_mainWakePending;
+    out.vblankPending = m_vblankPending;
+}
