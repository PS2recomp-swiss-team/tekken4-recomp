+
+    template <typename From, typename To>
+    void copyPending(const std::vector<From> &from, std::vector<To> &to)
+    {
+        to.clear();
+        to.reserve(from.size());
+        for (const From &item : from)
+        {
+            To copy{};
+            copy.fromScratchpad = item.fromScratchpad;
+            copy.srcAddr = item.srcAddr;
+            copy.qwc = item.qwc;
+            copy.chainData = item.chainData;
+            to.push_back(std::move(copy));
+        }
+    }
