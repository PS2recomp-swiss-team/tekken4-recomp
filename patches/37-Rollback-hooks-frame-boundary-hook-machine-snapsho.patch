+void EeScheduler::loadState(const SavedState &in)
+{
+    assertExecutor();
+    m_readyQueues = in.readyQueues;
+    m_threads = in.threads;
+    m_semaphores = in.semaphores;
+    m_eventFlags = in.eventFlags;
+    m_alarms = in.alarms;
+    m_intcHandlers = in.intcHandlers;
+    m_dmacHandlers = in.dmacHandlers;
+    m_nextThreadId = in.nextThreadId;
+    m_nextInvocationThreadId = in.nextInvocationThreadId;
+    m_nextSemaphoreId = in.nextSemaphoreId;
+    m_nextEventFlagId = in.nextEventFlagId;
+    m_nextAlarmId = in.nextAlarmId;
+    m_nextIntcHandlerId = in.nextIntcHandlerId;
+    m_nextDmacHandlerId = in.nextDmacHandlerId;
+    m_intcHeadOrder = in.intcHeadOrder;
+    m_intcTailOrder = in.intcTailOrder;
+    m_dmacHeadOrder = in.dmacHeadOrder;
+    m_dmacTailOrder = in.dmacTailOrder;
+    m_enabledIntcMask = in.enabledIntcMask;
+    m_enabledDmacMask = in.enabledDmacMask;
+    m_currentThreadId = in.currentThreadId;
+    m_rescheduleRequested = in.rescheduleRequested;
+    m_timeSliceExpired = in.timeSliceExpired;
+    m_insideInterrupt = in.insideInterrupt;
+    m_pendingEeTimerInterrupts = in.pendingEeTimerInterrupts;
+    m_eeCycle = in.eeCycle;
+    m_sliceEndCycle = in.sliceEndCycle;
+    {
+        std::lock_guard lock(m_eventMutex);
+        m_events = in.events;
+        m_deadlines = in.deadlines;
+        updateNextDeadline();
+    }
+    m_checkpointPending.store(in.checkpointPending, std::memory_order_release);
+    m_pendingInvocations = in.pendingInvocations;
+    m_eventSequence = in.eventSequence;
+    m_invocationSequence = in.invocationSequence;
+    m_vsyncTick = in.vsyncTick;
+    m_vsyncFlagAddress = in.vsyncFlagAddress;
+    m_vsyncTickAddress = in.vsyncTickAddress;
+    m_gsVSyncCallback = in.gsVSyncCallback;
+    m_gsVSyncCallbackGp = in.gsVSyncCallbackGp;
+    m_gsVSyncCallbackSp = in.gsVSyncCallbackSp;
+    m_invocationStackTops = in.invocationStackTops;
+    m_mainWakePending = in.mainWakePending;
+    m_vblankPending = in.vblankPending;
+    m_runtime.memory().gs().vsyncTick.store(m_vsyncTick, std::memory_order_release);
+    publishSnapshot();
+}
+
+namespace
+{
+    template <typename T>
+    void appendPod(std::vector<uint8_t> &out, const T &value)
+    {
+        const auto *bytes = reinterpret_cast<const uint8_t *>(&value);
+        out.insert(out.end(), bytes, bytes + sizeof(T));
+    }
+
+    template <typename Map>
+    std::vector<int> sortedKeys(const Map &map)
+    {
+        std::vector<int> keys;
+        keys.reserve(map.size());
+        for (const auto &[key, value] : map)
+        {
+            (void)value;
+            keys.push_back(key);
+        }
+        std::sort(keys.begin(), keys.end());
+        return keys;
+    }
+}
+
+void EeScheduler::appendStateDigest(std::vector<uint8_t> &out) const
+{
+    appendPod(out, m_eeCycle);
+    appendPod(out, m_vsyncTick);
+    appendPod(out, m_currentThreadId);
+    appendPod(out, m_pendingEeTimerInterrupts);
+    for (const auto &queue : m_readyQueues)
+    {
+        appendPod(out, static_cast<uint32_t>(queue.size()));
+        for (const int id : queue)
+        {
+            appendPod(out, id);
+        }
+    }
+    for (const int id : sortedKeys(m_threads))
+    {
+        const GuestThread &item = m_threads.at(id);
+        appendPod(out, id);
+        appendPod(out, item.status);
+        appendPod(out, item.wait.reason);
+        appendPod(out, waitObjectId(item.wait));
+        appendPod(out, item.currentPriority);
+        appendPod(out, item.suspendCount);
+        appendPod(out, item.wakeupCount);
+        appendPod(out, static_cast<uint32_t>(item.invocations.size()));
+        appendPod(out, static_cast<uint8_t>(item.resumeCompletion ? 1 : 0));
+        if (item.status != EeThreadStatus::Dormant)
+        {
+            appendPod(out, item.context);
+            for (const GuestInvocation &invocation : item.invocations)
+            {
+                appendPod(out, invocation.kind);
+                appendPod(out, invocation.context);
+            }
+        }
+    }
+    for (const int id : sortedKeys(m_semaphores))
+    {
+        const EeSemaphore &item = m_semaphores.at(id);
+        appendPod(out, id);
+        appendPod(out, item.count);
+        for (const int waiter : item.waiters)
+        {
+            appendPod(out, waiter);
+        }
+    }
+    for (const int id : sortedKeys(m_eventFlags))
+    {
+        const EeEventFlag &item = m_eventFlags.at(id);
+        appendPod(out, id);
+        appendPod(out, item.bits);
+        for (const int waiter : item.waiters)
+        {
+            appendPod(out, waiter);
+        }
+    }
+    for (const int id : sortedKeys(m_alarms))
+    {
+        appendPod(out, id);
+        appendPod(out, m_alarms.at(id).handler);
+    }
+    {
+        std::lock_guard lock(m_eventMutex);
+        std::vector<std::pair<uint64_t, uint32_t>> deadlines;
+        for (const ScheduledEvent &item : m_deadlines)
+        {
+            deadlines.emplace_back(item.deadlineCycle, (static_cast<uint32_t>(item.event.type) << 24) ^ item.event.id);
+        }
+        std::sort(deadlines.begin(), deadlines.end());
+        for (const auto &item : deadlines)
+        {
+            appendPod(out, item.first); // not the pair: its padding bytes are garbage
+            appendPod(out, item.second);
+        }
+    }
+    appendPod(out, static_cast<uint32_t>(m_pendingInvocations.size()));
+    for (const GuestInvocation &invocation : m_pendingInvocations)
+    {
+        appendPod(out, invocation.kind);
+        appendPod(out, invocation.context.pc);
+    }
+}
