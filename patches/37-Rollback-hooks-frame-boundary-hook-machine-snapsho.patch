+        regs.syncv = in[6];
+        regs.dispfb1 = in[7];
+        regs.display1 = in[8];
+        regs.dispfb2 = in[9];
+        regs.display2 = in[10];
+        regs.extbuf = in[11];
+        regs.extdata = in[12];
+        regs.extwrite = in[13];
+        regs.bgcolor = in[14];
+        regs.csr.store(in[15], std::memory_order_release);
+        regs.vsyncTick.store(in[16], std::memory_order_release);
+        regs.imr = in[17];
+        regs.busdir = in[18];
+        regs.siglblid = in[19];
