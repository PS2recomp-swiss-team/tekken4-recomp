+"""The Tekken 4 PAL adapter on a fake checkout: settings file, best settings, environment, sources, build steps."""
+import os
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from openrecomp import adapters, manifest as mf  # noqa: E402
+from openrecomp.adapters import t4pal  # noqa: E402
+from openrecomp.adapters.base import Missing  # noqa: E402
+
+
+def touch(path, data=b""):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "wb") as f:
+        f.write(data)
+
+
+class Pal(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        base = self.tmp.name
+        self.root = os.path.join(base, "tekken4-recomp")
+        self.tree = os.path.join(base, "tekken4-fork-ps2recomp")
+        touch(os.path.join(self.root, "tools", "run_game.cmd"))
+        touch(os.path.join(self.root, "tools", "build_game.cmd"))
+        touch(os.path.join(self.root, "config", "ghidra_export.toml"))
+        self.env = mock.patch.dict(os.environ, {"OPENRECOMP_HOME": os.path.join(base, "home")})
+        self.env.start()
+        self.screen = mock.patch.object(t4pal, "screen_height", return_value=1440)
+        self.screen.start()
+        self.m = mf.validate(dict(id="t4pal", title="Tekken 4", numeral="4", accent="#F0414E", adapter="t4pal",
+                                  locations=[self.root], sections=["play", "build", "settings"]))
+
+    def tearDown(self):
+        self.screen.stop()
+        self.env.stop()
+        self.tmp.cleanup()
+
+    def adapter(self):
+        a = adapters.make(self.m, {})
+        self.assertIsInstance(a, t4pal.T4Pal)
+        return a
+
+    def built(self):
+        touch(os.path.join(self.root, "game", "disc", "SCES_508.78"))
+        touch(os.path.join(self.tree, "out", "runtime", "ps2xRuntime", "ps2EntryRunner.exe"))
+
+    def test_the_manifest_and_the_folder_are_found(self):
+        self.assertEqual(self.adapter().tree, self.tree)
+        other = dict(self.m, locations=[os.path.join(self.tmp.name, "elsewhere")])
+        self.assertIsInstance(adapters.make(other, {}), Missing)
+
+    def test_best_settings_follow_the_screen(self):
+        self.assertEqual([t4pal.best_settings(h)["internal_scale"] for h in (720, 1080, 1440, 2160)], [2, 3, 3, 4])
+        best = t4pal.best_settings(1080)
+        self.assertEqual((best["aspect"], best["widescreen"], best["no_interlace"], best["fxaa"]), (1, 1, 1, 1))
+
+    def test_the_first_start_writes_the_best_settings_once(self):
+        a = self.adapter()
+        self.assertEqual(a.settings()[0]["value"], 3)            # shown before the file exists
+        self.assertTrue(a.ensure_settings())
+        a.set_setting("internal_scale", 2)
+        self.assertFalse(a.ensure_settings())                    # the player's choice stays
+        self.assertEqual(t4pal.read_ini(a.settings_path())["internal_scale"], "2")
+
+    def test_changing_a_setting_keeps_the_games_other_lines(self):
+        a = self.adapter()
+        t4pal.write_ini(a.settings_path(), {"aspect": "0", "controls_layout": "xbox", "controls_key_CROSS": "88"})
+        a.set_setting("aspect", 1)
+        self.assertEqual(t4pal.read_ini(a.settings_path()),
+                         {"aspect": "1", "controls_layout": "xbox", "controls_key_CROSS": "88"})
+        values = {s["id"]: s["value"] for s in a.settings()}
+        self.assertEqual((values["aspect"], values["internal_scale"]), (1, 1))  # missing keys: the game's own default
+
+    def test_launcher_only_settings_are_kept_by_the_launcher(self):
+        a = self.adapter()
+        a.set_setting("window", "maximized")
+        a.set_setting("sound", False)
+        self.assertFalse(os.path.isfile(a.settings_path()) and "window" in t4pal.read_ini(a.settings_path()))
+        b = self.adapter()
+        self.assertEqual((b.state["window"], b.state["sound"]), ("maximized", False))
+
+    def test_ready_only_with_the_program_and_a_build(self):
+        a = self.adapter()
+        self.assertFalse(a.ready())
+        self.assertIn("SCES_508.78", a.status()["detail"])
+        self.built()
+        self.assertTrue(a.ready())
+
+    def test_the_game_runs_on_its_own_tree_and_settings(self):
+        a = self.adapter()
+        env = a.game_env()
+        self.assertEqual(env["TEKKEN4_SRC"], self.tree)
+        self.assertEqual(env["PS2X_SETTINGS"], a.settings_path())
+        self.assertNotIn("PS2X_DEBUG_PANEL", env)                # unset keeps F1 working
+        a.set_setting("debug_panel", True)
+        self.assertEqual(a.game_env({"X": "1"})["PS2X_DEBUG_PANEL"], "1")
+
+    def test_a_running_lock_holder_blocks_play(self):
+        self.built()
+        a = self.adapter()
+        touch(a.lock_path(), f"{os.getpid()} run_capture test\n".encode())
+        with self.assertRaises(RuntimeError):
+            a.start()
+        touch(a.lock_path(), b"")
+        self.assertEqual(a.run_lock_holder(), "")
+
+    def test_the_program_is_checked_and_never_replaced(self):
+        a = self.adapter()
+        wrong = os.path.join(self.tmp.name, "SCES_508.78")
+        touch(wrong, b"not the game")
+        self.assertIn("not SCES_508.78", a.set_source("elf", wrong))
+        self.assertFalse(os.path.isfile(os.path.join(self.root, "game", "disc", "SCES_508.78")))
+        with mock.patch.object(t4pal, "sha1", return_value=t4pal.ELF_SHA1):
+            self.assertEqual(a.set_source("elf", wrong), "Copied to game\\disc.")
+            self.assertIn("already there", a.set_source("elf", wrong))
+
+    def test_build_steps_are_read_from_the_script(self):
+        a = self.adapter()
+        self.assertIn("SCES_508.78", a.build_ready())
+        self.built()
+        self.assertEqual(a.build_ready(), "")
+        for line in ("[1/4] tools - host tools", "noise", "[2/4] recomp - recompile"):
+            a._on_line(line)
+        self.assertEqual(a.build_done, {"tools": True})
+        self.assertEqual((a.build_step, a.build_step_no), ("recomp", (2, 4)))
+
+
+if __name__ == "__main__":
+    unittest.main()
